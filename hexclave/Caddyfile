{
	admin off
	auto_https off
	persist_config off
	log {
		level WARN
	}
}

:{$PORT} {
	# Dashboard-only API routes.
	@dashboard_api path /api/viewer-location /api/development-environment/* /api/remote-development-environment/*
	handle @dashboard_api {
		reverse_proxy 127.0.0.1:{$DASHBOARD_PORT}
	}

	# Everything else under /api, plus the health endpoint, is the Hexclave API backend.
	@backend path /api /api/* /health /health/*
	handle @backend {
		reverse_proxy 127.0.0.1:{$BACKEND_PORT} {
			header_up X-Forwarded-Proto https
		}
	}

	handle {
		reverse_proxy 127.0.0.1:{$DASHBOARD_PORT} {
			header_up X-Forwarded-Proto https
		}
	}

	handle_errors 502 503 504 {
		respond "Hexclave is starting (first boot runs database migrations, a few minutes). Refresh shortly." 503
	}
}
